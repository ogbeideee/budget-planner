{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./out/**)",
      "Read(./coverage/**)",
      "Read(./public/vendor/**)",
      "Read(./node_modules/**/*.js)",
      "Read(./node_modules/**/*.mjs)",
      "Read(./node_modules/**/*.cjs)",
      "Read(./node_modules/**/*.ts)",
      "Read(./package-lock.json)",
      "Read(**/*.wasm)",
      "Read(**/*.traineddata)",
      "Read(**/*.map)",
      "Read(**/*.lock)",
      "Read(**/*.tsbuildinfo)",
      "Read(**/*.log)"
    ]
  }
}
