{
  "name": "budget-planner",
  "version": "0.1.0",
  "productName": "Budget Planner",
  "private": true,
  "description": "Offline personal budget planner (Planner, To-Do, Upcoming, Timeline, Reports, Settings).",
  "author": "Budget Planner",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n react,electron \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "next dev",
    "dev:electron": "wait-on -t 60000 http://localhost:3000 && electron . --dev",
    "electron": "electron .",
    "db:check": "electron electron/scripts/dbcheck.cjs",
    "electron:rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "build": "next build",
    "dist": "electron-builder --win",
    "start": "electron .",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:smoke": "npm run build && electron . --smoke",
    "desktop:package": "npm run build && npm run dist",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.budgetplanner.desktop",
    "productName": "Budget Planner",
    "files": [
      "out/**",
      "electron/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Budget Planner",
      "artifactName": "BudgetPlanner-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "BudgetPlanner-Portable-${version}.exe"
    }
  }
}
